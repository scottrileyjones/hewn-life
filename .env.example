# Stripe — server-side secret (never expose to client)
STRIPE_SECRET_KEY=sk_live_...

# Stripe — client-side publishable key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Stripe — subscription plan Price IDs
NEXT_PUBLIC_STRIPE_PRICE_HEWN_MONTHLY=price_...
NEXT_PUBLIC_STRIPE_PRICE_HEWN_ANNUAL=price_...
NEXT_PUBLIC_STRIPE_PRICE_WROUGHT_MONTHLY=price_...
NEXT_PUBLIC_STRIPE_PRICE_WROUGHT_ANNUAL=price_...
NEXT_PUBLIC_STRIPE_PRICE_FORGED_MONTHLY=price_...
NEXT_PUBLIC_STRIPE_PRICE_FORGED_ANNUAL=price_...

# Stripe — Website in a Day (one-time $999). Create this price in Stripe and
# set it in Vercel; without it the order form still sends the brief and we invoice by email.
NEXT_PUBLIC_STRIPE_PRICE_WEBSITE_IN_A_DAY=price_...

# Stripe — à la carte service Price IDs
NEXT_PUBLIC_STRIPE_PRICE_SERVICE_EXTRA_AD_CREATIVE=price_...
NEXT_PUBLIC_STRIPE_PRICE_SERVICE_EMAIL_AUTOMATION=price_...
NEXT_PUBLIC_STRIPE_PRICE_SERVICE_SEO_BLOG_POST=price_...
NEXT_PUBLIC_STRIPE_PRICE_SERVICE_VIDEO_REPURPOSING=price_...
NEXT_PUBLIC_STRIPE_PRICE_SERVICE_WHITEPAPER=price_...
NEXT_PUBLIC_STRIPE_PRICE_SERVICE_COMPETITOR_AUDIT=price_...
NEXT_PUBLIC_STRIPE_PRICE_SERVICE_BRAND_REFRESH=price_...
NEXT_PUBLIC_STRIPE_PRICE_SERVICE_WEBSITE_COPY=price_...

# Airtable — quiz lead capture
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE_ID=tblXXXXXXXXXXXXXX
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX

# Google Tag Manager — container ID (configure GA4 + other tags inside GTM).
# Defaults to the Hewn Life container (GTM-5D8JJD5R) in code; override here to
# point a different environment at a different container.
NEXT_PUBLIC_GTM_ID=GTM-5D8JJD5R

# Airtable — website briefs (hewn.life/start and Cal.com bookings).
# Same base and token as quiz leads; a separate table. See docs/sales/intake-forms.md.
AIRTABLE_BRIEFS_TABLE_ID=tblXXXXXXXXXXXXXX

# Cal.com — signing secret for the BOOKING_CREATED webhook (/api/cal-webhook).
CAL_WEBHOOK_SECRET=

# ── Growth plans (personal decks for every lead) ──────────────────────────────
# Claude writes each deck. Without a key, decks fall back to rule-based plans.
ANTHROPIC_API_KEY=
# Resend sends the review, plan and follow-up emails (hewnlife.com must be verified in Resend).
RESEND_API_KEY=
PLAN_FROM_EMAIL="Hewn Life <hello@hewnlife.com>"
PLAN_REVIEW_EMAIL=hello@hewnlife.com
# Postal address for the email footer (required by CAN-SPAM for follow-ups).
PLAN_MAIL_ADDRESS=
# Airtable table for plans, in the same base as leads (see lib/plans/store.ts for columns).
AIRTABLE_PLANS_TABLE_ID=
# Any long random string; signs review and unsubscribe links.
PLAN_SECRET=
# Set to true to send plans without the review step.
PLAN_AUTO_SEND=false
# Vercel sends this to /api/cron/plans; any long random string.
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=https://www.hewn.life
